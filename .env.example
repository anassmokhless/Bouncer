# =============================================================================
# Bouncer — Environment Variable Template
# =============================================================================
# Copy this file to .env and fill in real values.
#   cp .env.example .env
#
# Required variables are validated at startup (src/shared/env.ts). The app will
# refuse to boot if any are missing. Optional variables have sensible defaults.
# =============================================================================

# -----------------------------------------------------------------------------
# Database (required)
# -----------------------------------------------------------------------------
# Postgres connection string. TLS is inferred from the URL: keep the
# sslmode=require (or verify-full) param that managed providers like Neon
# include, and the app connects over TLS. For the bundled docker-compose
# Postgres, omit sslmode entirely:
#   DATABASE_URL="postgres://bouncer:<POSTGRES_PASSWORD>@postgres:5432/bouncer"
DATABASE_URL="postgres://user:password@host:5432/dbname"

# Password for the Postgres container in docker-compose.prod.yml. Only used by
# that service (and by DATABASE_URL when you point it at the bundled Postgres).
# Not required when you use an external/managed database.
POSTGRES_PASSWORD="PASTE_A_STRONG_RANDOM_PASSWORD_HERE"

# -----------------------------------------------------------------------------
# Telegram (required)
# -----------------------------------------------------------------------------
# Bot token from @BotFather.
BOT_TOKEN="0000000000:AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA"

# Bot username WITHOUT the leading @ (used to build t.me/<name>?start=verify links).
BOT_USERNAME="your_bot_username"

# -----------------------------------------------------------------------------
# Enjin Blockchain (required)
# -----------------------------------------------------------------------------
# Enjin Platform GraphQL endpoint.
ENJIN_API_URL="https://platform.enjin.io/graphql"

# API token from platform.enjin.io. Required — the platform rejects
# unauthenticated queries. Creating linking codes also needs the developer
# profile on that account to be completed.
ENJIN_API_TOKEN=""

# Chain to query. ENJIN/MATRIX is mainnet, CANARY/MATRIX is testnet.
ENJIN_NETWORK="ENJIN"
ENJIN_CHAIN="MATRIX"

# -----------------------------------------------------------------------------
# Dashboard (required)
# -----------------------------------------------------------------------------
# Session-signing secret. Generate with:
#   node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
SESSION_SECRET="PASTE_A_64_BYTE_HEX_STRING_HERE"

# -----------------------------------------------------------------------------
# Dashboard (optional)
# -----------------------------------------------------------------------------
# HTTP port the dashboard listens on. Default: 3000.
PORT="3000"

# Set to "production" on deployed environments — enables secure cookies and
# hard-disables the dev login regardless of ENABLE_DEV_LOGIN. The production
# compose file pins NODE_ENV=production on both app containers, so this value
# mainly matters for non-Docker deployments and local development.
NODE_ENV="development"

# Number of reverse-proxy hops in front of the app. Default: 1 (single nginx/
# Cloudflare layer). Use "2" for Cloudflare → nginx → app. Accepts Express
# keywords like "loopback" or "uniquelocal" too.
TRUST_PROXY="1"

# Enables GET /auth/dev — a passwordless "log in as any user" endpoint for
# local development. Requires NODE_ENV to NOT be "production" as well; in
# production it is always off regardless of this flag. Leave blank/false
# unless you are actively developing the dashboard.
ENABLE_DEV_LOGIN="false"

# -----------------------------------------------------------------------------
# Bouncer Pass — early access gate (optional)
# -----------------------------------------------------------------------------
# Enjin collection ID for the Bouncer MFT. Leave blank to disable the early
# access check (anyone can add the bot to their group).
#
# WARNING: do NOT enable this on a deployment that already has groups. Groups
# whose admins hold no pass get left AND deleted (rules, members, and audit
# logs included) within ~10 minutes of the flag going live.
BOUNCER_COLLECTION_ID=""

# Specific token ID within the collection. Leave blank to accept any token in
# the collection.
BOUNCER_TOKEN_ID=""

# -----------------------------------------------------------------------------
# Contact form — Nodemailer SMTP. Only used by the dashboard's contact form,
# but validated at startup by both processes, so these must be set (dummy
# values work if you don't use the form).
# -----------------------------------------------------------------------------
# SMTP server. For Gmail, use smtp.gmail.com with an App Password
# (Google Account → Security → 2-Step Verification → App Passwords).
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"

# Set to "true" only if your SMTP server requires TLS on connect (port 465).
# For STARTTLS on port 587, leave as "false".
SMTP_SECURE="false"

SMTP_USER="your-email@gmail.com"
SMTP_PASS="your-app-password"

# Inbox that receives contact form submissions. Can be the same as SMTP_USER.
CONTACT_EMAIL="your-email@gmail.com"
