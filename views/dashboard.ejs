<%- include('partials/head', { title: 'Dashboard — Bouncer' }) %>
<%- include('partials/nav') %>

<div class="max-w-6xl mx-auto px-4 py-8">
  <h1 class="text-2xl font-bold mb-6">Your Groups</h1>

  <% if (groups.length === 0) { %>
    <div class="bg-slate-900 border border-slate-800 rounded-xl p-6 text-gray-400">
      No groups found. Add the bot to a Telegram group and use /addrule to get started.
    </div>
  <% } else { %>
    <div class="grid gap-4 md:grid-cols-2 lg:grid-cols-3">
      <% groups.forEach(group => { %>
        <a href="/dashboard/<%= group.id %>" class="block">
          <div class="bg-slate-900 border border-slate-800 rounded-xl p-5 hover:border-cyan-500/50 transition-colors">
            <h2 class="font-semibold text-lg mb-3 text-gray-100"><%= group.title %></h2>
            <div class="flex gap-2 flex-wrap">
              <span class="bg-emerald-500/15 text-emerald-400 text-xs px-2 py-1 rounded-full">
                <%= group.verified_count %> verified
              </span>
              <span class="bg-purple-500/15 text-purple-400 text-xs px-2 py-1 rounded-full">
                <%= group.rule_count %> rules
              </span>
              <span class="<%= group.is_active ? 'bg-cyan-500/15 text-cyan-400' : 'bg-red-500/15 text-red-400' %> text-xs px-2 py-1 rounded-full">
                <%= group.is_active ? 'Active' : 'Inactive' %>
              </span>
            </div>
          </div>
        </a>
      <% }) %>
    </div>
  <% } %>
</div>

<%- include('partials/footer') %>