<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= typeof title !== 'undefined' ? title : 'Bouncer' %></title>

  <%# Must run before the stylesheet to prevent a flash of the wrong theme. %>
  <script nonce="<%= cspNonce %>">
    (function() {
      try {
        var saved = localStorage.getItem('theme');
        if (saved === 'light') {
          // explicit light — leave as-is
        } else if (saved === 'dark') {
          document.documentElement.classList.add('dark');
        } else {
          // no saved preference — follow the OS, default dark
          var prefersLight = window.matchMedia
            && window.matchMedia('(prefers-color-scheme: light)').matches;
          if (!prefersLight) document.documentElement.classList.add('dark');
        }
      } catch (_) {
        document.documentElement.classList.add('dark');
      }
    })();
    window.__toggleTheme = function() {
      var nowDark = document.documentElement.classList.toggle('dark');
      try { localStorage.setItem('theme', nowDark ? 'dark' : 'light'); } catch (_) {}
    };
    // Bind the theme-toggle buttons (marked data-theme-toggle) via
    // addEventListener rather than inline onclick, so the CSP can forbid inline
    // event-handler attributes.
    document.addEventListener('DOMContentLoaded', function() {
      document.querySelectorAll('[data-theme-toggle]').forEach(function(btn) {
        btn.addEventListener('click', window.__toggleTheme);
      });
    });
  </script>

  <link rel="stylesheet" href="/css/output.css">
  <style>html { scrollbar-gutter: stable; }</style>
</head>
<body class="bg-slate-50 dark:bg-slate-950 text-slate-900 dark:text-gray-100 min-h-screen">
