<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= typeof title !== 'undefined' ? title : 'Bouncer' %></title>

  <%# Theme bootstrap — MOET synchroon en vóór de stylesheet draaien om FOUC
      (flash of wrong theme) te voorkomen. Leest opgeslagen voorkeur uit
      localStorage; zonder voorkeur volgt 't systeem, defaulted to dark
      als 't systeem niks aangeeft. Zet `dark` class op <html> voor eerste
      paint zodat Tailwind's dark: variants meteen de juiste kant opstaan.

      Ook globale __toggleTheme() exposed — de sun/moon button in nav-app
      gebruikt 'm via onclick. Try/catch rond localStorage zodat private
      mode / strict privacy settings de app niet breken. %>
  <script>
    (function() {
      try {
        var saved = localStorage.getItem('theme');
        if (saved === 'light') {
          // expliciet light — niks doen, geen dark class
        } else if (saved === 'dark') {
          document.documentElement.classList.add('dark');
        } else {
          // geen voorkeur opgeslagen — respecteer OS, default naar dark
          var prefersLight = window.matchMedia
            && window.matchMedia('(prefers-color-scheme: light)').matches;
          if (!prefersLight) document.documentElement.classList.add('dark');
        }
      } catch (_) {
        document.documentElement.classList.add('dark');
      }
    })();
    window.__toggleTheme = function() {
      var nowDark = document.documentElement.classList.toggle('dark');
      try { localStorage.setItem('theme', nowDark ? 'dark' : 'light'); } catch (_) {}
    };
  </script>

  <link rel="stylesheet" href="/css/output.css">
  <%# Reserveer altijd scrollbar-ruimte, ook op niet-scrollende pagina's —
      voorkomt horizontale sprong wanneer je wisselt tussen korte (geen
      scrollbar) en lange (wel scrollbar) pagina's. %>
  <style>html { scrollbar-gutter: stable; }</style>
</head>
<body class="bg-slate-50 dark:bg-slate-950 text-slate-900 dark:text-gray-100 min-h-screen">
