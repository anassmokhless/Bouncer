<%# Public-site nav. Used by landing, contact, legal. Sticky + backdrop-blur
    because marketing pages are long-scroll; always-visible nav helps re-entry.
    Logo always links to "/". Pass `active` ('contact' | 'legal') to highlight
    a section. "Admin Portal" is a CTA button, not a neutral link — it's the
    primary conversion on public pages.

    Light/dark: elke color-class heeft een `dark:` pair. De sun/moon toggle
    button roept __toggleTheme() aan (globaal gedefinieerd in head.ejs). %>
<% const navActive = typeof active !== 'undefined' ? active : null; %>
<nav class="bg-white/80 dark:bg-slate-900/80 border-b border-slate-200 dark:border-slate-800 backdrop-blur-sm sticky top-0 z-50 uppercase tracking-wide">
  <div class="max-w-6xl mx-auto px-4 py-3 flex items-center justify-between">
    <a href="/" class="flex items-center gap-2">
      <img src="/images/logo.png" alt="Bouncer" class="w-8 h-8 rounded-lg" />
      <span class="text-lg font-bold text-cyan-600 dark:text-cyan-400">Bouncer</span>
    </a>
    <div class="flex items-center gap-4">
      <a href="/contact"
         class="text-sm <%= navActive === 'contact' ? 'text-cyan-600 dark:text-cyan-400' : 'text-slate-600 dark:text-gray-400 hover:text-cyan-600 dark:hover:text-cyan-400' %> transition-colors">Contact</a>
      <a href="/legal"
         class="text-sm <%= navActive === 'legal' ? 'text-cyan-600 dark:text-cyan-400' : 'text-slate-600 dark:text-gray-400 hover:text-cyan-600 dark:hover:text-cyan-400' %> transition-colors">Legal</a>

      <%# Theme toggle — zelfde pattern als in nav-app. Sun zichtbaar in dark,
          moon zichtbaar in light. type="button" zodat 'ie geen form submit. %>
      <button type="button" data-theme-toggle
              class="inline-flex items-center justify-center w-9 h-9 rounded-lg border border-slate-300 dark:border-slate-700 text-slate-600 dark:text-gray-400 hover:bg-slate-100 dark:hover:bg-slate-800 transition-colors"
              aria-label="Toggle theme">
        <svg class="w-4 h-4 hidden dark:block" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                d="M12 3v1m0 16v1m9-9h-1M4 12H3m15.364 6.364l-.707-.707M6.343 6.343l-.707-.707m12.728 0l-.707.707M6.343 17.657l-.707.707M16 12a4 4 0 11-8 0 4 4 0 018 0z"/>
        </svg>
        <svg class="w-4 h-4 block dark:hidden" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                d="M20.354 15.354A9 9 0 018.646 3.646 9.003 9.003 0 0012 21a9.003 9.003 0 008.354-5.646z"/>
        </svg>
      </button>

      <a href="/dashboard"
         class="bg-cyan-600 text-white px-4 py-2 rounded-lg text-sm font-medium hover:bg-cyan-700 dark:hover:bg-cyan-500 transition-colors">Admin Portal</a>
    </div>
  </div>
</nav>
