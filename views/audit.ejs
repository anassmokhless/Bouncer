<%- include('partials/head', { title: 'Audit Logs — Bouncer' }) %>
<%- include('partials/nav') %>

<div class="max-w-6xl mx-auto px-4 py-8">
  <h1 class="text-2xl font-bold mb-6">Audit Logs</h1>

  <!-- Legend -->
  <details class="mb-6 bg-slate-900 border border-slate-800 rounded-xl">
    <summary class="px-5 py-3 cursor-pointer text-sm font-medium text-gray-400 hover:text-gray-200">What do these actions mean?</summary>
    <div class="px-5 pb-4 grid grid-cols-1 sm:grid-cols-2 gap-3 text-sm">
      <div class="flex items-start gap-2">
        <span class="bg-emerald-500/15 text-emerald-400 text-xs px-2 py-1 rounded-full whitespace-nowrap">USER_VERIFIED</span>
        <span class="text-gray-400">User linked their wallet and NFT ownership was confirmed.</span>
      </div>
      <div class="flex items-start gap-2">
        <span class="bg-emerald-500/15 text-emerald-400 text-xs px-2 py-1 rounded-full whitespace-nowrap">USER_AUTO_VERIFIED</span>
        <span class="text-gray-400">User joined and already had a linked wallet with the required NFT.</span>
      </div>
      <div class="flex items-start gap-2">
        <span class="bg-red-500/15 text-red-400 text-xs px-2 py-1 rounded-full whitespace-nowrap">USER_KICKED</span>
        <span class="text-gray-400">User was removed — NFT no longer held or verification timed out.</span>
      </div>
      <div class="flex items-start gap-2">
        <span class="bg-red-500/15 text-red-400 text-xs px-2 py-1 rounded-full whitespace-nowrap">USER_BANNED</span>
        <span class="text-gray-400">User was banned after 5 failed verification attempts.</span>
      </div>
      <div class="flex items-start gap-2">
        <span class="bg-red-500/15 text-red-400 text-xs px-2 py-1 rounded-full whitespace-nowrap">USER_KICKED_MANUAL</span>
        <span class="text-gray-400">Admin triggered a recheck from the dashboard and the user lost access.</span>
      </div>
      <div class="flex items-start gap-2">
        <span class="bg-cyan-500/15 text-cyan-400 text-xs px-2 py-1 rounded-full whitespace-nowrap">RULE_ADDED</span>
        <span class="text-gray-400">Admin added a new NFT rule to a group.</span>
      </div>
      <div class="flex items-start gap-2">
        <span class="bg-gray-500/15 text-gray-400 text-xs px-2 py-1 rounded-full whitespace-nowrap">RULE_REMOVED</span>
        <span class="text-gray-400">Admin removed an NFT rule from a group.</span>
      </div>
      <div class="flex items-start gap-2">
        <span class="bg-gray-500/15 text-gray-400 text-xs px-2 py-1 rounded-full whitespace-nowrap">USER_LEFT</span>
        <span class="text-gray-400">User left the group on their own.</span>
      </div>
    </div>
  </details>

  <div class="bg-slate-900 border border-slate-800 rounded-xl">
    <div class="px-5 py-4 border-b border-slate-800 flex items-center justify-between flex-wrap gap-3">
      <h2 class="font-semibold text-cyan-400">Logs (<%= totalLogs %>)</h2>
      <form method="GET" action="/dashboard/audit" class="flex items-center gap-2">
        <input type="text" name="search" value="<%= search %>" placeholder="Search username..."
               class="bg-slate-800 border border-slate-700 rounded-lg px-3 py-1.5 text-sm text-gray-100 placeholder-gray-500 focus:outline-none focus:border-cyan-500 w-48">
        <button type="submit" class="bg-slate-700 text-gray-300 px-3 py-1.5 rounded-lg text-sm hover:bg-slate-600 transition-colors">Search</button>
        <% if (search) { %>
          <a href="/dashboard/audit" class="text-xs text-gray-500 hover:text-gray-300 transition-colors">Clear</a>
        <% } %>
      </form>
    </div>
    <% if (logs.length === 0) { %>
      <p class="p-6 text-gray-500"><%= search ? 'No logs found.' : 'No audit logs yet.' %></p>
    <% } else { %>
      <div class="overflow-x-auto">
        <table class="w-full text-sm">
          <thead>
            <tr class="border-b border-slate-800 text-left">
              <th class="px-5 py-3 font-medium text-gray-400">Time</th>
              <th class="px-5 py-3 font-medium text-gray-400">Group</th>
              <th class="px-5 py-3 font-medium text-gray-400">Action</th>
              <th class="px-5 py-3 font-medium text-gray-400">User</th>
              <th class="px-5 py-3 font-medium text-gray-400">Details</th>
            </tr>
          </thead>
          <tbody>
            <% const actionColors = { USER_VERIFIED: 'bg-emerald-500/15 text-emerald-400', USER_AUTO_VERIFIED: 'bg-emerald-500/15 text-emerald-400', USER_KICKED: 'bg-red-500/15 text-red-400', USER_KICKED_MANUAL: 'bg-red-500/15 text-red-400', USER_LEFT: 'bg-gray-500/15 text-gray-400', RULE_ADDED: 'bg-cyan-500/15 text-cyan-400', RULE_REMOVED: 'bg-gray-500/15 text-gray-400' }; %>
            <% logs.forEach(log => { %>
              <tr class="border-b border-slate-800">
                <td class="px-5 py-3 text-gray-500 whitespace-nowrap" data-date="<%= log.created_at %>"></td>
                <td class="px-5 py-3 font-medium text-gray-100"><%= log.group_title %></td>
                <td class="px-5 py-3">
                  <span class="<%= actionColors[log.action] || 'bg-gray-500/15 text-gray-400' %> text-xs px-2 py-1 rounded-full">
                    <%= log.action %>
                  </span>
                </td>
                <td class="px-5 py-3 text-gray-300"><%= log.user_first_name || log.user_username || 'System' %></td>
                <td class="px-5 py-3 text-xs text-gray-500">
                  <% if (log.details && Object.keys(log.details).length > 0) { %>
                    <div class="space-y-1">
                      <% Object.entries(log.details).forEach(([key, value]) => { %>
                        <div>
                          <span class="text-gray-500"><%= key %>:</span>
                          <span class="text-gray-300 font-mono ml-1"><%= value != null ? value : 'Any' %></span>
                        </div>
                      <% }) %>
                    </div>
                  <% } else { %>
                    <span class="text-gray-600">—</span>
                  <% } %>
                </td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      </div>
    <% } %>
    <% if (totalPages > 1) { %>
      <div class="px-5 py-4 border-t border-slate-800 flex items-center justify-between">
        <p class="text-sm text-gray-500">Page <%= page %> of <%= totalPages %></p>
        <div class="flex gap-2">
          <% if (page > 1) { %>
            <a href="/dashboard/audit?page=<%= page - 1 %><%= search ? '&search=' + encodeURIComponent(search) : '' %>"
               class="bg-slate-800 text-gray-300 px-3 py-1.5 rounded-lg text-sm hover:bg-slate-700 transition-colors">&larr; Prev</a>
          <% } %>
          <% if (page < totalPages) { %>
            <a href="/dashboard/audit?page=<%= page + 1 %><%= search ? '&search=' + encodeURIComponent(search) : '' %>"
               class="bg-slate-800 text-gray-300 px-3 py-1.5 rounded-lg text-sm hover:bg-slate-700 transition-colors">Next &rarr;</a>
          <% } %>
        </div>
      </div>
    <% } %>
  </div>
</div>

<script>
document.querySelectorAll('[data-date]').forEach(el => {
  const d = el.dataset.date;
  el.textContent = d ? new Date(d).toLocaleString() : 'Never';
});
</script>

<%- include('partials/footer') %>