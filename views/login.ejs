<%- include('partials/head', { title: 'Login — Bouncer' }) %>

<div class="flex items-center justify-center min-h-screen">
  <div class="bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 rounded-xl shadow-xl shadow-slate-300/50 dark:shadow-2xl p-8 w-full max-w-sm text-center">
    <img src="/images/logo.png" alt="Bouncer" class="w-28 h-28 mx-auto mb-5 rounded-2xl shadow-lg shadow-cyan-500/10">
    <h1 class="text-2xl font-bold text-cyan-600 dark:text-cyan-400 mb-2">Bouncer</h1>
    <p class="text-sm text-slate-600 dark:text-gray-400 mb-6">Sign in with your Telegram account to manage your groups.</p>

    <!-- Telegram Login Widget — data-onauth (JS callback via postMessage) instead
         of data-auth-url (popup → redirect). data-auth-url was less reliable:
         Telegram's popup sometimes closed before the redirect landed, causing
         nginx 499s. data-onauth hands us the auth blob directly in the parent
         window; we POST it (below) rather than putting it in a URL, so the
         signed blob never leaks into nginx logs, browser history, or Referer.

         The widget doesn't follow our theme class — it auto-detects via
         prefers-color-scheme. On a mismatch between the user toggle and the OS
         preference it can look light or dark independent of our page. There's
         no Telegram API to force it; accepted. -->
    <div class="flex justify-center mb-4">
      <script async src="https://telegram.org/js/telegram-widget.js?22"
              data-telegram-login="<%= botUsername %>"
              data-size="large"
              data-onauth="onTelegramAuth(user)"
              data-request-access="write"></script>
    </div>
    <p id="login-error" class="text-sm text-red-600 dark:text-red-400 mb-4" hidden></p>
    <script nonce="<%= cspNonce %>">
      // CSRF token is httpOnly in the cookie (JS can't read it), so the server
      // injects it here for the POST below to echo in the X-CSRF-Token header.
      const CSRF_TOKEN = "<%= csrfToken %>";
      async function onTelegramAuth(user) {
        // The widget hands us { id, first_name, username, photo_url, auth_date, hash }.
        // POST it as JSON so the signed blob stays out of the URL. A fetch won't
        // follow the server's redirect as a navigation, so the route replies 204
        // and we navigate here on success.
        const errEl = document.getElementById('login-error');
        errEl.hidden = true;
        try {
          const res = await fetch('/auth/telegram/callback', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json', 'X-CSRF-Token': CSRF_TOKEN },
            body: JSON.stringify(user),
          });
          if (res.ok) {
            window.location.href = '/dashboard';
            return;
          }
          errEl.textContent = (await res.text()) || 'Login failed. Please try again.';
          errEl.hidden = false;
        } catch (e) {
          errEl.textContent = 'Network error. Please try again.';
          errEl.hidden = false;
        }
      }
    </script>

    <% if (isDev) { %>
      <hr class="my-4 border-slate-200 dark:border-slate-700">
      <p class="text-xs text-slate-500 dark:text-gray-500 mb-2">Dev Login (development only)</p>
      <form action="/auth/dev" method="get" class="flex gap-2">
        <input type="text" name="telegramId" placeholder="Telegram ID"
               class="flex-1 bg-white dark:bg-slate-800 border border-slate-300 dark:border-slate-700 rounded-lg px-3 py-2 text-sm text-slate-900 dark:text-gray-100 placeholder-slate-400 dark:placeholder-gray-500 focus:outline-none focus:border-cyan-500">
        <button type="submit"
                class="bg-cyan-600 text-white px-4 py-2 rounded-lg text-sm hover:bg-cyan-700 dark:hover:bg-cyan-500 transition-colors">
          Login
        </button>
      </form>
    <% } %>
  </div>
</div>

<%- include('partials/footer') %>
